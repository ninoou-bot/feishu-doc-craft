<!-- 模式 1：场景痛点与对标对决表 (Scenario PK Table) -->
<table>
  <colgroup><col width="28%"/><col width="36%"/><col width="36%"/></colgroup>
  <thead>
    <tr>
      <th vertical-align="top"><p><b>细分场景痛点</b></p></th>
      <th vertical-align="top"><p><b>本品场景匹配与卖点</b></p></th>
      <th vertical-align="top"><p><b>竞品 A / 竞品 B 同场景应对</b></p></th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td vertical-align="top">
        <p><b>[场景名称]</b></p>
        <p>具象痛点描述（如全家长途出行颠簸易晕车、第三排空间局促）</p>
      </td>
      <td vertical-align="top">
        <p><b>[核心系统/配置亮点]</b></p>
        <p>硬核参数与场景收益（如电磁智能悬挂毫秒级滤震；第三排翻折魔术空间）</p>
      </td>
      <td vertical-align="top">
        <p><b>竞品 A：</b>指出具体缺失（如无智能可变悬挂，颠簸感明显）</p>
        <p><b>竞品 B：</b>指出参数弱项（如单阀配置，舒适性滤震不足）</p>
      </td>
    </tr>
  </tbody>
</table>

